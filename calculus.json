    {"id": 36, "prompt": "The derivative of csc \u03b8 is", "choices": [{"letter": "A", "text": "sec \u03b8 tan \u03b8"}, {"letter": "B", "text": "-csc\u00b2 \u03b8"}, {"letter": "C", "text": "-csc \u03b8 cot \u03b8"}, {"letter": "D", "text": "-csc \u03b8 tan \u03b8"}], "answer": "C", "note": "Sourced from elements_in_calculus.md[cite: 6]"},
    {"id": 37, "prompt": "Catenary is the shape assumed by perfectly flexible uniform cable hanging between supports. It is a graph of", "choices": [{"letter": "A", "text": "parabola"}, {"letter": "B", "text": "y = sin h x"}, {"letter": "C", "text": "y = cos h x"}, {"letter": "D", "text": "x = cos hy"}], "answer": "C", "note": "Sourced from elements_in_calculus.md[cite: 6]"},
    {"id": 38, "prompt": "The quantity 2/ (e^x - e^-x) is equal to", "choices": [{"letter": "A", "text": "cosh x"}, {"letter": "B", "text": "tanh x"}, {"letter": "C", "text": "csch x"}, {"letter": "D", "text": "sech x"}], "answer": "C", "note": "Sourced from elements_in_calculus.md[cite: 6]"},
    {"id": 39, "prompt": "What is 1-tan h\u00b2 x equal to?", "choices": [{"letter": "A", "text": "sec h\u00b2 x"}, {"letter": "B", "text": "cos h\u00b2 x"}, {"letter": "C", "text": "cot h\u00b2 x"}, {"letter": "D", "text": "csc h\u00b2 x"}], "answer": "A", "note": "Sourced from elements_in_calculus.md[cite: 6]"},
    {"id": 40, "prompt": "In calculus, all functions are classified as either algebraic or transcendental. Which of the following is NOT an algebraic function?", "choices": [{"letter": "A", "text": "Rational integral function"}, {"letter": "B", "text": "Irrational function"}, {"letter": "C", "text": "Rational fractional function"}, {"letter": "D", "text": "Exponential logarithmic function"}], "answer": "D", "note": "Sourced from elements_in_calculus.md[cite: 6]"},
    {"id": 41, "prompt": "The integral of sin\u1d50 \u03b8 cos\u207f \u03b8 d\u03b8 can easily be determined by using Wallis formula provided the limits are form", "choices": [{"letter": "A", "text": "0 to \u03c0"}, {"letter": "B", "text": "0 to \u03c0/2"}, {"letter": "C", "text": "0 to \u03c0/4"}, {"letter": "D", "text": "0 to 2\u03c0"}], "answer": "B", "note": "Sourced from elements_in_calculus.md[cite: 6]"},
    {"id": 42, "prompt": "The integral of any quotient whose numerator is the difference of the denominator is the ______ of the denominator.", "choices": [{"letter": "A", "text": "reciprocal"}, {"letter": "B", "text": "product"}, {"letter": "C", "text": "logarithm"}, {"letter": "D", "text": "derivative"}], "answer": "C", "note": "Sourced from elements_in_calculus.md[cite: 6]"},
    {"id": 43, "prompt": "Many integrals may be evaluated by introducing a new variable of integration in place of the original variable, the two variables being connected by some suitable formulas. This process is called", "choices": [{"letter": "A", "text": "integration by parts"}, {"letter": "B", "text": "integration by substitution"}, {"letter": "C", "text": "partial derivatives"}, {"letter": "D", "text": "the chain rule"}], "answer": "B", "note": "Sourced from elements_in_calculus.md[cite: 6]"},
    {"id": 44, "prompt": "The variable inside the integral is called variable of integration or integration variable. It is sometimes referred to as", "choices": [{"letter": "A", "text": "calculus variable"}, {"letter": "B", "text": "dummy variable"}, {"letter": "C", "text": "limits variable"}, {"letter": "D", "text": "limits range"}], "answer": "B", "note": "Sourced from elements_in_calculus.md[cite: 6]"},
    {"id": 45, "prompt": "The value of x in trigonometric substitution with an integrand involving (a\u00b2 -x\u00b2) is", "choices": [{"letter": "A", "text": "a sec \u03b8"}, {"letter": "B", "text": "a tan \u03b8"}, {"letter": "C", "text": "a cos \u03b8"}, {"letter": "D", "text": "a sin \u03b8"}], "answer": "D", "note": "Sourced from elements_in_calculus.md[cite: 6]"},
    {"id": 46, "prompt": "The area of the surface generated by rotating any plane curve about a certain axis in its plane id equal to the product of the length of the arc and the distance traveled by its centroid.", "choices": [{"letter": "A", "text": "Varignon's theorem"}, {"letter": "B", "text": "First proposition of Pappus"}, {"letter": "C", "text": "Method of section"}, {"letter": "D", "text": "Second proposition of Pappus"}], "answer": "B", "note": "Sourced from elements_in_calculus.md[cite: 6]"},
    {"id": 47, "prompt": "The volume of any solid revolution is equal to the generating are times the circumference of the circle described by the centroid of the area. This is known as", "choices": [{"letter": "A", "text": "First proposition of Pappus"}, {"letter": "B", "text": "Cavalieri's theorem"}, {"letter": "C", "text": "Second proposition of Pappus"}, {"letter": "D", "text": "Simpson's Rule"}], "answer": "C", "note": "Sourced from elements_in_calculus.md[cite: 6]"},
    {"id": 48, "prompt": "Newton was inspired by an apple. Pappus propositions were inspired by what fruits?", "choices": [{"letter": "A", "text": "Apple and pear"}, {"letter": "B", "text": "Lemon and orange"}, {"letter": "C", "text": "Apple and Lemon"}, {"letter": "D", "text": "Apple and banana"}], "answer": "C", "note": "Sourced from elements_in_calculus.md[cite: 6]"},
    {"id": 49, "prompt": "When the ellipse is rotated about is shorter axis, the ellipsoid is", "choices": [{"letter": "A", "text": "paraboloid"}, {"letter": "B", "text": "prolate"}, {"letter": "C", "text": "spheroid"}, {"letter": "D", "text": "oblate"}], "answer": "D", "note": "Sourced from elements_in_calculus.md[cite: 6]"},
    {"id": 50, "prompt": "When the ellipse is rotated about its longer axis, the ellipsoid is", "choices": [{"letter": "A", "text": "paraboloid"}, {"letter": "B", "text": "prolate"}, {"letter": "C", "text": "spheroid"}, {"letter": "D", "text": "oblate"}], "answer": "B", "note": "Sourced from elements_in_calculus.md[cite: 6]"},
    {"id": 51, "prompt": "When a catenary (y = cosh x) is rotated about its axis of symmetry, it generates a solid called", "choices": [{"letter": "A", "text": "paraboloid"}, {"letter": "B", "text": "conoid"}, {"letter": "C", "text": "catenoid"}, {"letter": "D", "text": "hyperboloid"}], "answer": "C", "note": "Sourced from elements_in_calculus.md[cite: 6]"},
    {"id": 52, "prompt": "A solid of revolution of a parabola is known as", "choices": [{"letter": "A", "text": "paraboloid"}, {"letter": "B", "text": "hyperboloid"}, {"letter": "C", "text": "catenoid"}, {"letter": "D", "text": "conoid"}], "answer": "A", "note": "Sourced from elements_in_calculus.md[cite: 6]"},
    {"id": 53, "prompt": "A ______ section of a surface of revolution is the section containing the axis of revolution.", "choices": [{"letter": "A", "text": "right"}, {"letter": "B", "text": "central"}, {"letter": "C", "text": "median"}, {"letter": "D", "text": "meridian"}], "answer": "D", "note": "Sourced from elements_in_calculus.md[cite: 6]"},
    {"id": 54, "prompt": "Who invented the symbol \"\u221e\" for infinity?", "choices": [{"letter": "A", "text": "John Stockton"}, {"letter": "B", "text": "John Venn"}, {"letter": "C", "text": "John Wallis"}, {"letter": "D", "text": "John Napier"}], "answer": "C", "note": "Sourced from elements_in_calculus.md[cite: 6]"},
    {"id": 55, "prompt": "Calculus was invented by", "choices": [{"letter": "A", "text": "Newton"}, {"letter": "B", "text": "Leibniz"}, {"letter": "C", "text": "Gauss"}, {"letter": "D", "text": "Newton and Leibniz"}], "answer": "D", "note": "Sourced from elements_in_calculus.md[cite: 6]"},
