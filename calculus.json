{
  "topic": "Calculus & Differential Equation",
  "questions": [
    {"id": 1, "prompt": "When f(x) is negative the curve of y = f(x) is concave", "choices": [{"letter": "A", "text": "downward"}, {"letter": "B", "text": "to the right"}, {"letter": "C", "text": "upward"}, {"letter": "D", "text": "to the left"}], "answer": "A", "note": "Sourced from elements_in_calculus.md"},
    {"id": 2, "prompt": "If the second derivative of the equation of a curve is equal to the negative of the equation of that same curve, the curve is", "choices": [{"letter": "A", "text": "a paraboloid"}, {"letter": "B", "text": "a sinusoid"}, {"letter": "C", "text": "a cissoid"}, {"letter": "D", "text": "an exponential"}], "answer": "B", "note": "Sourced from elements_in_calculus.md"},
    {"id": 3, "prompt": "A function F(x) is called ______ of f(x) if F'(x) = f(x).", "choices": [{"letter": "A", "text": "explicit function"}, {"letter": "B", "text": "derivative"}, {"letter": "C", "text": "implicit function"}, {"letter": "D", "text": "antiderivative"}], "answer": "D", "note": "Sourced from elements_in_calculus.md[cite: 6]"},
    {"id": 4, "prompt": "Points of derivatives which do not exists (and so equals zero) are called", "choices": [{"letter": "A", "text": "stationary points"}, {"letter": "B", "text": "minimum points"}, {"letter": "C", "text": "maximum points"}, {"letter": "D", "text": "minimum and maximum points"}], "answer": "D", "note": "Sourced from elements_in_calculus.md[cite: 6]"},
    {"id": 5, "prompt": "At the point of inflection where x = a,", "choices": [{"letter": "A", "text": "f\"(a)>0"}, {"letter": "B", "text": "f\"(a)=0"}, {"letter": "C", "text": "f\"(a)>0"}, {"letter": "D", "text": "f\"(a)<0"}], "answer": "B", "note": "Sourced from elements_in_calculus.md[cite: 6]"},
    {"id": 6, "prompt": "At the minimum point, the slope of the tangent line is", "choices": [{"letter": "A", "text": "negative"}, {"letter": "B", "text": "infinity"}, {"letter": "C", "text": "positive"}, {"letter": "D", "text": "zero"}], "answer": "D", "note": "Sourced from elements_in_calculus.md[cite: 6]"},
    {"id": 7, "prompt": "What is the point where the second derivative is zero?", "choices": [{"letter": "A", "text": "Maxima"}, {"letter": "B", "text": "Minima"}, {"letter": "C", "text": "Inflection point"}, {"letter": "D", "text": "Point of intersection"}], "answer": "C", "note": "Sourced from elements_in_calculus.md[cite: 6]"},
    {"id": 8, "prompt": "The point on the curve where the second derivative of a function is equal to zero is called", "choices": [{"letter": "A", "text": "maxima"}, {"letter": "B", "text": "minima"}, {"letter": "C", "text": "point of inflection"}, {"letter": "D", "text": "critical point"}], "answer": "C", "note": "Sourced from elements_in_calculus.md[cite: 6]"},
    {"id": 9, "prompt": "The point of the curve where the first derivative of a function is zero and the second derivative is positive is called_", "choices": [{"letter": "A", "text": "maxima"}, {"letter": "B", "text": "minima"}, {"letter": "C", "text": "point of inflection"}, {"letter": "D", "text": "critical point"}], "answer": "B", "note": "Sourced from elements_in_calculus.md[cite: 6]"},
    {"id": 10, "prompt": "Evaluate the integral of tanh u du.", "choices": [{"letter": "A", "text": "In sin hu+c"}, {"letter": "B", "text": "In cos hu+c"}, {"letter": "C", "text": "cos hu+c"}, {"letter": "D", "text": "cot hu + c"}], "answer": "B", "note": "Sourced from elements_in_calculus.md[cite: 6]"},
    {"id": 11, "prompt": "The derivative of a^u with respect to x is_", "choices": [{"letter": "A", "text": "a^u Ina du/dx"}, {"letter": "B", "text": "a^u Inu du/dx"}, {"letter": "C", "text": "u^a Ina du/dx"}, {"letter": "D", "text": "Inu du/dx"}], "answer": "A", "note": "Sourced from elements_in_calculus.md[cite: 6]"},
    {"id": 12, "prompt": "If y = tanh x, find dy/dx.", "choices": [{"letter": "A", "text": "sech\u00b2 x"}, {"letter": "B", "text": "-sech\u00b2x"}, {"letter": "C", "text": "sech x tanh x"}, {"letter": "D", "text": "-sech x tanh x"}], "answer": "A", "note": "Sourced from elements_in_calculus.md[cite: 6]"},
    {"id": 13, "prompt": "The field of mathematics which rest on upon the fundaments concept of limits and was created by Newton and Leibniz.", "choices": [{"letter": "A", "text": "Physics"}, {"letter": "B", "text": "Calculus"}, {"letter": "C", "text": "Boolean Algebra"}, {"letter": "D", "text": "Quantum Mechanics"}], "answer": "B", "note": "Sourced from elements_in_calculus.md[cite: 6]"},
    {"id": 14, "prompt": "The ______ of a relation is the set of second elements of the pair in the relation.", "choices": [{"letter": "A", "text": "domain"}, {"letter": "B", "text": "range"}, {"letter": "C", "text": "graph"}, {"letter": "D", "text": "function"}], "answer": "B", "note": "Sourced from elements_in_calculus.md[cite: 6]"},
    {"id": 15, "prompt": "A relation in which there is exactly one range element associated with each domain element.", "choices": [{"letter": "A", "text": "Graph"}, {"letter": "B", "text": "Set"}, {"letter": "C", "text": "Formula"}, {"letter": "D", "text": "Function"}], "answer": "D", "note": "Sourced from elements_in_calculus.md[cite: 6]"},
    {"id": 16, "prompt": "The ______ of a relation is the set of first elements of pairs in the relation.", "choices": [{"letter": "A", "text": "domain"}, {"letter": "B", "text": "range"}, {"letter": "C", "text": "graph"}, {"letter": "D", "text": "function"}], "answer": "A", "note": "Sourced from elements_in_calculus.md[cite: 6]"},
    {"id": 17, "prompt": "Any set of ordered pair is called a", "choices": [{"letter": "A", "text": "relation"}, {"letter": "B", "text": "range"}, {"letter": "C", "text": "domain"}, {"letter": "D", "text": "graph"}], "answer": "A", "note": "Sourced from elements_in_calculus.md[cite: 6]"},
    {"id": 18, "prompt": "Any pair of elements (x, y) having a first element x and a second element y is called", "choices": [{"letter": "A", "text": "range"}, {"letter": "B", "text": "domain"}, {"letter": "C", "text": "coordinates"}, {"letter": "D", "text": "ordered pair"}], "answer": "D", "note": "Sourced from elements_in_calculus.md[cite: 6]"},
    {"id": 19, "prompt": "The operation of finding the derivative of a function.", "choices": [{"letter": "A", "text": "Differentiating"}, {"letter": "B", "text": "Differentiation"}, {"letter": "C", "text": "Differential"}, {"letter": "D", "text": "Integrating"}], "answer": "B", "note": "Sourced from elements_in_calculus.md[cite: 6]"},
    {"id": 20, "prompt": "The derivative of a function is identical to the ______ of the graph of the function.", "choices": [{"letter": "A", "text": "tangent"}, {"letter": "B", "text": "secant"}, {"letter": "C", "text": "slope"}, {"letter": "D", "text": "normal"}], "answer": "C", "note": "Sourced from elements_in_calculus.md[cite: 6]"},
    {"id": 21, "prompt": "The ______ derivative of the function is the rate of change of the slope of the graph.", "choices": [{"letter": "A", "text": "first"}, {"letter": "B", "text": "second"}, {"letter": "C", "text": "third"}, {"letter": "D", "text": "fourth"}], "answer": "B", "note": "Sourced from elements_in_calculus.md[cite: 6]"},
    {"id": 22, "prompt": "A point on the graph where the tangent line is either horizontal or vertical is known as", "choices": [{"letter": "A", "text": "point of inflection"}, {"letter": "B", "text": "critical point"}, {"letter": "C", "text": "stationary point"}, {"letter": "D", "text": "All of these"}], "answer": "B", "note": "Sourced from elements_in_calculus.md[cite: 6]"},
    {"id": 23, "prompt": "The critical points of a graph occur when the derivative of a function is", "choices": [{"letter": "A", "text": "zero"}, {"letter": "B", "text": "approaches infinity"}, {"letter": "C", "text": "zero or approaches infinity"}, {"letter": "D", "text": "either 1 or -1"}], "answer": "C", "note": "Sourced from elements_in_calculus.md[cite: 6]"},
    {"id": 24, "prompt": "At point of inflection,.", "choices": [{"letter": "A", "text": "y' = 0"}, {"letter": "B", "text": "y\" = 0"}, {"letter": "C", "text": "y\" is negative"}, {"letter": "D", "text": "y\" is positive"}], "answer": "B", "note": "Sourced from elements_in_calculus.md[cite: 6]"},
    {"id": 25, "prompt": "At a point where y' = 0, if y changes from positive to negative as x increases,", "choices": [{"letter": "A", "text": "y is minimum"}, {"letter": "B", "text": "x is minimum"}, {"letter": "C", "text": "y is maximum"}, {"letter": "D", "text": "x is maximum"}], "answer": "C", "note": "Sourced from elements_in_calculus.md[cite: 6]"},
    {"id": 26, "prompt": "The point where the second derivative of a function is zero.", "choices": [{"letter": "A", "text": "Maximum point"}, {"letter": "B", "text": "Minimum point"}, {"letter": "C", "text": "Point of intersection"}, {"letter": "D", "text": "Point of inflection"}], "answer": "D", "note": "Sourced from elements_in_calculus.md[cite: 6]"},
    {"id": 27, "prompt": "The point where the first derivative of a function is zero and the second derivative is positive.", "choices": [{"letter": "A", "text": "Maximum point"}, {"letter": "B", "text": "Minimum point"}, {"letter": "C", "text": "Point of inflection"}, {"letter": "D", "text": "Critical point"}], "answer": "B", "note": "Sourced from elements_in_calculus.md[cite: 6]"},
    {"id": 28, "prompt": "A point at which the curve changes from concave upward to concave downward and vice versa is known as", "choices": [{"letter": "A", "text": "point of intersection"}, {"letter": "B", "text": "point of deflection"}, {"letter": "C", "text": "point of inflection"}, {"letter": "D", "text": "yield point"}], "answer": "C", "note": "Sourced from elements_in_calculus.md[cite: 6]"},
    {"id": 29, "prompt": "At a point where y' = 0, if y changes from positive to negative as x increases_", "choices": [{"letter": "A", "text": "y is maximum"}, {"letter": "B", "text": "y is minimum"}, {"letter": "C", "text": "x is maximum"}, {"letter": "D", "text": "y is minimum"}], "answer": "A", "note": "Sourced from elements_in_calculus.md[cite: 6]"},
    {"id": 30, "prompt": "At maximum point,.", "choices": [{"letter": "A", "text": "the curve is concave downward"}, {"letter": "B", "text": "y\" is negative"}, {"letter": "C", "text": "y' = 0"}, {"letter": "D", "text": "All of these"}], "answer": "D", "note": "Sourced from elements_in_calculus.md[cite: 6]"},
    {"id": 31, "prompt": "______ is also known as the composite function rule.", "choices": [{"letter": "A", "text": "L'Hospital rule"}, {"letter": "B", "text": "Trapezoidal rule"}, {"letter": "C", "text": "Simpson's rule"}, {"letter": "D", "text": "Chain rule"}], "answer": "D", "note": "Sourced from elements_in_calculus.md[cite: 6]"},
    {"id": 32, "prompt": "The L'Hospital rule was formulated by.", "choices": [{"letter": "A", "text": "Marquis de l'Hospital"}, {"letter": "B", "text": "Marrione de l'Hospital"}, {"letter": "C", "text": "J. Bernoulli"}, {"letter": "D", "text": "I. Newton"}], "answer": "C", "note": "Sourced from elements_in_calculus.md[cite: 6]"},
    {"id": 33, "prompt": "A collective term for maxima or minima, whether absolute of relative is called", "choices": [{"letter": "A", "text": "infinitium"}, {"letter": "B", "text": "extrema"}, {"letter": "C", "text": "domain"}, {"letter": "D", "text": "none of these"}], "answer": "B", "note": "Sourced from elements_in_calculus.md[cite: 6]"},
    {"id": 34, "prompt": "Which of the following is not determinate form?", "choices": [{"letter": "A", "text": "00.00"}, {"letter": "B", "text": "\u221e + \u221e"}, {"letter": "C", "text": "-\u221e-\u221e"}, {"letter": "D", "text": "\u221e/\u221e"}], "answer": "D", "note": "Sourced from elements_in_calculus.md[cite: 6]"},
