    {"id": 9, "prompt": "Kind of obligation which has no condition attached.", "choices": [{"letter": "A", "text": "Analytic"}, {"letter": "B", "text": "Pure"}, {"letter": "C", "text": "Gratuitous"}, {"letter": "D", "text": "Private"}], "answer": "C", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 10, "prompt": "Direct labor cost incurred in the factory and direct materials cost are the costs of all materials that go into production. The sum of these two direct costs is known as", "choices": [{"letter": "A", "text": "GS and A expenses"}, {"letter": "B", "text": "Operating and maintenance costs"}, {"letter": "C", "text": "Prime cost"}, {"letter": "D", "text": "O and M costs"}], "answer": "C", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 11, "prompt": "An index of short term paying ability is called ______.", "choices": [{"letter": "A", "text": "receivable turn-over"}, {"letter": "B", "text": "profit margin ratio"}, {"letter": "C", "text": "current ratio"}, {"letter": "D", "text": "acid-test ratio"}], "answer": "D", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 12, "prompt": "An artificial expenses that spreads the purchase price of an asset or another property over a number of years.", "choices": [{"letter": "A", "text": "Depreciation"}, {"letter": "B", "text": "Sinking fund"}, {"letter": "C", "text": "Amnesty"}, {"letter": "D", "text": "Bond"}], "answer": "A", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 13, "prompt": "Estimated value at the end of the useful life.", "choices": [{"letter": "A", "text": "Market value"}, {"letter": "B", "text": "Fair value"}, {"letter": "C", "text": "Salvage value"}, {"letter": "D", "text": "Book value"}], "answer": "C", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 14, "prompt": "Consists of the actual counting or determination of the actual quantity of the materials on hand as of a given date.", "choices": [{"letter": "A", "text": "Physical inventory"}, {"letter": "B", "text": "Material update"}, {"letter": "C", "text": "Technological assessment"}, {"letter": "D", "text": "Material count"}], "answer": "A", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 15, "prompt": "Additional information of prospective bidders on contract documents issued prior to bidding date.", "choices": [{"letter": "A", "text": "Delict"}, {"letter": "B", "text": "Escalatory"}, {"letter": "C", "text": "Technological assessment"}, {"letter": "D", "text": "Bid bulletin"}], "answer": "D", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 16, "prompt": "An evil wrong committed by a person damaged another person's property or reputation is", "choices": [{"letter": "A", "text": "tort"}, {"letter": "B", "text": "material breach"}, {"letter": "C", "text": "negligence"}, {"letter": "D", "text": "fraud"}], "answer": "A", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 17, "prompt": "A series of uniform accounts over an infinite period of time.", "choices": [{"letter": "A", "text": "Depreciation"}, {"letter": "B", "text": "Annuity"}, {"letter": "C", "text": "Perpetuity"}, {"letter": "D", "text": "Inflation"}], "answer": "C", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 18, "prompt": "The quantity of a certain commodity that is offered for sale at a certain price at a given place and time.", "choices": [{"letter": "A", "text": "Demand"}, {"letter": "B", "text": "Supply"}, {"letter": "C", "text": "Stocks"}, {"letter": "D", "text": "Goods"}], "answer": "B", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 19, "prompt": "Work-in process is classified as ______.", "choices": [{"letter": "A", "text": "an asset"}, {"letter": "B", "text": "a liability"}, {"letter": "C", "text": "an expenses"}, {"letter": "D", "text": "an owner's equity"}], "answer": "A", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 20, "prompt": "What is the highest position in the corporation?", "choices": [{"letter": "A", "text": "President"}, {"letter": "B", "text": "Board of Directors"}, {"letter": "C", "text": "Chairman of the Board"}, {"letter": "D", "text": "Stockholders"}], "answer": "C", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 21, "prompt": "Type of ownership in business where individuals exercise and enjoy the right in their own interest.", "choices": [{"letter": "A", "text": "Equitable"}, {"letter": "B", "text": "Public"}, {"letter": "C", "text": "Private"}, {"letter": "D", "text": "Pure"}], "answer": "C", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 22, "prompt": "Decrease in the value of a physical property due to the passage of time.", "choices": [{"letter": "A", "text": "Inflation"}, {"letter": "B", "text": "Depletion"}, {"letter": "C", "text": "Recession"}, {"letter": "D", "text": "Depreciation"}], "answer": "D", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 23, "prompt": "An association of two or more individuals for the purpose of operating a business as co-owners for profit.", "choices": [{"letter": "A", "text": "Sole proprietorship"}, {"letter": "B", "text": "Company"}, {"letter": "C", "text": "Partnership"}, {"letter": "D", "text": "Corporation"}], "answer": "C", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 24, "prompt": "We may classify an interest rate, which specifies the actual rate of interest on the principal for one year as", "choices": [{"letter": "A", "text": "nominal rate"}, {"letter": "B", "text": "rate of return"}, {"letter": "C", "text": "exact interest rate"}, {"letter": "D", "text": "effective rate"}], "answer": "D", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 25, "prompt": "Parties whose consent or signature in a contract is not considered intelligent.", "choices": [{"letter": "A", "text": "Dead persons"}, {"letter": "B", "text": "Senior citizens"}, {"letter": "C", "text": "Demented persons"}, {"letter": "D", "text": "Minors"}], "answer": "C", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 26, "prompt": "It is defined to be the capacity of a commodity to satisfy human want.", "choices": [{"letter": "A", "text": "Discount"}, {"letter": "B", "text": "Luxury"}, {"letter": "C", "text": "Necessity"}, {"letter": "D", "text": "Utility"}], "answer": "D", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 27, "prompt": "It is the amount which a willing buyer will pay to a willing seller for a property where each has equal advantage and is under no compulsion to buy or sell.", "choices": [{"letter": "A", "text": "Fair value"}, {"letter": "B", "text": "Market value"}, {"letter": "C", "text": "Book value"}, {"letter": "D", "text": "Salvage value"}], "answer": "B", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 28, "prompt": "This occurs in a situation where a commodity or service is supplied by a number of vendors entering the market.", "choices": [{"letter": "A", "text": "Perfect competition"}, {"letter": "B", "text": "Oligopoly"}, {"letter": "C", "text": "Monopoly"}, {"letter": "D", "text": "Elastic demand"}], "answer": "A", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 29, "prompt": "These are products or services that are desired by human and will be purchased if money is available after the required necessities have been obtained.", "choices": [{"letter": "A", "text": "Utilities"}, {"letter": "B", "text": "Necessities"}, {"letter": "C", "text": "Luxuries"}, {"letter": "D", "text": "Product goods and services"}], "answer": "C", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 30, "prompt": "These are products or services that are required to support human life and activities, that will be purchased in somewhat the same quantity even though the price varies considerably.", "choices": [{"letter": "A", "text": "Utilities"}, {"letter": "B", "text": "Necessities"}, {"letter": "C", "text": "Luxuries"}, {"letter": "D", "text": "Product goods and services"}], "answer": "B", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 31, "prompt": "A condition where only few individuals produce a certain product and that any action of one will lead to almost the same action of the others.", "choices": [{"letter": "A", "text": "Oligopoly"}, {"letter": "B", "text": "Semi-monopoly"}, {"letter": "C", "text": "Monopoly"}, {"letter": "D", "text": "Perfect competition"}], "answer": "A", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 32, "prompt": "Grand total of the assets and operational capability of a corporation.", "choices": [{"letter": "A", "text": "Authorized capital"}, {"letter": "B", "text": "Investment"}, {"letter": "C", "text": "Subscribed capital"}, {"letter": "D", "text": "Money market"}], "answer": "A", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 33, "prompt": "The worth of the property equals to the original cost less depreciation.", "choices": [{"letter": "A", "text": "Scrap value"}, {"letter": "B", "text": "Face value"}, {"letter": "C", "text": "Market value"}, {"letter": "D", "text": "Book value"}], "answer": "D", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 34, "prompt": "Money paid for the use of borrowed capital.", "choices": [{"letter": "A", "text": "Discount"}, {"letter": "B", "text": "Credit"}, {"letter": "C", "text": "Interest"}, {"letter": "D", "text": "Profit"}], "answer": "C", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 35, "prompt": "Liquid assets such as cash and other assets that can be converted quickly into cash, such as accounts receivable and merchandise are called", "choices": [{"letter": "A", "text": "total assets"}, {"letter": "B", "text": "fixed assets"}, {"letter": "C", "text": "current assets"}, {"letter": "D", "text": "none of these"}], "answer": "C", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 36, "prompt": "The length of time which the property may be operated at a profit.", "choices": [{"letter": "A", "text": "Physical life"}, {"letter": "B", "text": "Economic life"}, {"letter": "C", "text": "Operating life"}, {"letter": "D", "text": "All of these"}], "answer": "B", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 37, "prompt": "The provision in the contract that indicates the possible adjustment of material cost and labor cost.", "choices": [{"letter": "A", "text": "Secondary clause"}, {"letter": "B", "text": "Escalatory clause"}, {"letter": "C", "text": "Contingency clause"}, {"letter": "D", "text": "Main clause"}], "answer": "B", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 38, "prompt": "The present worth of all depreciation over the economic life of the item is called", "choices": [{"letter": "A", "text": "book value"}, {"letter": "B", "text": "capital recovery"}, {"letter": "C", "text": "depreciation recovery"}, {"letter": "D", "text": "sinking fund"}], "answer": "C", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 39, "prompt": "Gross profit, sales less cost of good sold, as a percentage of a sales is called ______.", "choices": [{"letter": "A", "text": "profit margin"}, {"letter": "B", "text": "gross margin"}, {"letter": "C", "text": "net income"}, {"letter": "D", "text": "rate of return"}], "answer": "B", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 40, "prompt": "Worth of the property as shown in the accounting records of an enterprise.", "choices": [{"letter": "A", "text": "Fair value"}, {"letter": "B", "text": "Market value"}, {"letter": "C", "text": "Salvage value"}, {"letter": "D", "text": "Book value"}], "answer": "D", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 41, "prompt": "Those funds that are required to make the enterprise or project a going concern.", "choices": [{"letter": "A", "text": "Initial investment"}, {"letter": "B", "text": "Current accounts"}, {"letter": "C", "text": "Working capital"}, {"letter": "D", "text": "Subscribed capital"}], "answer": "C", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 42, "prompt": "A market situation where there is only one seller with many buyer.", "choices": [{"letter": "A", "text": "Monopoly"}, {"letter": "B", "text": "Monopsony"}, {"letter": "C", "text": "Oligopoly"}, {"letter": "D", "text": "Oligopsony"}], "answer": "A", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 43, "prompt": "A market situation where there are few sellers and few buyers.", "choices": [{"letter": "A", "text": "Oligopoly"}, {"letter": "B", "text": "Oligopsony"}, {"letter": "C", "text": "Bilateral oligopoly"}, {"letter": "D", "text": "Bilateral oligopsony"}], "answer": "C", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 44, "prompt": "A market situation where there is one seller and one buyer.", "choices": [{"letter": "A", "text": "Monopoly"}, {"letter": "B", "text": "Monopsony"}, {"letter": "C", "text": "Bilateral monopoly"}, {"letter": "D", "text": "Bilateral monopsony"}], "answer": "C", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 45, "prompt": "A market situation where there are only two buyers with many sellers.", "choices": [{"letter": "A", "text": "duopoly"}, {"letter": "B", "text": "oligopoly"}, {"letter": "C", "text": "duopsony"}, {"letter": "D", "text": "oligopsony"}], "answer": "C", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 46, "prompt": "The cumulative effect of elapsed time on the money value of an event, based on the earning power of equivalent invested funds capital should or will earn.", "choices": [{"letter": "A", "text": "Present worth factor"}, {"letter": "B", "text": "Interest rate"}, {"letter": "C", "text": "Time value of money"}, {"letter": "D", "text": "Yield"}], "answer": "C", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 47, "prompt": "Defined as the future value minus the present value.", "choices": [{"letter": "A", "text": "interest"}, {"letter": "B", "text": "discount"}, {"letter": "C", "text": "discount"}, {"letter": "D", "text": "capital"}], "answer": "C", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 48, "prompt": "The flow back of profit plus depreciation from a given project is called", "choices": [{"letter": "A", "text": "capital recovery"}, {"letter": "B", "text": "cash flow"}, {"letter": "C", "text": "economic return"}, {"letter": "D", "text": "earning value"}], "answer": "B", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 49, "prompt": "The profit derived from a project or business enterprise without consideration of obligations to financial contributions or claims of other based on profit.", "choices": [{"letter": "A", "text": "Economic return"}, {"letter": "B", "text": "Yield"}, {"letter": "C", "text": "Earning value"}, {"letter": "D", "text": "Expected yield"}], "answer": "A", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 50, "prompt": "The payment for the use of borrowed money is called ______.", "choices": [{"letter": "A", "text": "loan"}, {"letter": "B", "text": "maturity value"}, {"letter": "C", "text": "interest"}, {"letter": "D", "text": "principal"}], "answer": "C", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 51, "prompt": "The interest rate at which the present work of the cash on a project is zero of the interest earned by an investment.", "choices": [{"letter": "A", "text": "Effective rate"}, {"letter": "B", "text": "Nominal rate"}, {"letter": "C", "text": "Rate of return"}, {"letter": "D", "text": "Yield"}], "answer": "C", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 52, "prompt": "The ratio of the interest payment to be principal for a given unit of time and usually expressed as a percentage of the principal.", "choices": [{"letter": "A", "text": "interest"}, {"letter": "B", "text": "interest rate"}, {"letter": "C", "text": "investment"}, {"letter": "D", "text": "All of these"}], "answer": "B", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 53, "prompt": "The true value of interest rate computed by equations for compound interest for a 1 year period is known as ______.", "choices": [{"letter": "A", "text": "expected return"}, {"letter": "B", "text": "interest"}, {"letter": "C", "text": "nominal interest"}, {"letter": "D", "text": "effective interest"}], "answer": "D", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 54, "prompt": "The intangible item of value from the exclusive right of a company in a stated region of the country.", "choices": [{"letter": "A", "text": "Market value"}, {"letter": "B", "text": "Book value"}, {"letter": "C", "text": "Goodwill value"}, {"letter": "D", "text": "Franchise value"}], "answer": "D", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 55, "prompt": "The recorded current value of an asset is known as ______.", "choices": [{"letter": "A", "text": "scrap value"}, {"letter": "B", "text": "salvage value"}, {"letter": "C", "text": "book value"}, {"letter": "D", "text": "present worth"}], "answer": "C", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 56, "prompt": "Scrap value of an asset is sometimes known as ______.", "choices": [{"letter": "A", "text": "book value"}, {"letter": "B", "text": "salvage value"}, {"letter": "C", "text": "replacement value"}, {"letter": "D", "text": "future value"}], "answer": "B", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 57, "prompt": "Sometimes called second hand value.", "choices": [{"letter": "A", "text": "Scrap value"}, {"letter": "B", "text": "Salvage value"}, {"letter": "C", "text": "Book value"}, {"letter": "D", "text": "Going value"}], "answer": "B", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 58, "prompt": "An intangible value which is actually operating concern has due to its operation.", "choices": [{"letter": "A", "text": "Book value"}, {"letter": "B", "text": "Fair value"}, {"letter": "C", "text": "Goodwill value"}, {"letter": "D", "text": "Going value"}], "answer": "D", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 59, "prompt": "The value which has a disinterested third party, different from the buyer and seller, will determine in order to establish a price acceptable to both parties.", "choices": [{"letter": "A", "text": "Market value"}, {"letter": "B", "text": "Goodwill value"}, {"letter": "C", "text": "Fair value"}, {"letter": "D", "text": "Franchise value"}], "answer": "C", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 60, "prompt": "A type of annuity where the payments are made at the end of each payment period staring from the first period.", "choices": [{"letter": "A", "text": "Ordinary annuity"}, {"letter": "B", "text": "Annuity due"}, {"letter": "C", "text": "Deferred annuity"}, {"letter": "D", "text": "Perpetuity"}], "answer": "A", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 61, "prompt": "It is a series of equal payments occurring at equal intervals of time where the first payment is made after several periods, after the beginning of the payment.", "choices": [{"letter": "A", "text": "Deferred annuity"}, {"letter": "B", "text": "Delayed annuity"}, {"letter": "C", "text": "Progressive annuity"}, {"letter": "D", "text": "Simple annuity"}], "answer": "A", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 62, "prompt": "A type of annuity where the payments are made at the start of each period, beginning from the first period.", "choices": [{"letter": "A", "text": "Ordinary annuity"}, {"letter": "B", "text": "Annuity due"}, {"letter": "C", "text": "Deferred annuity"}, {"letter": "D", "text": "Perpetuity"}], "answer": "B", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 63, "prompt": "Which is NOT an essential element of an ordinary annuity?", "choices": [{"letter": "A", "text": "The amounts of all payments are equal."}, {"letter": "B", "text": "The payments are made at equal interval of time."}, {"letter": "C", "text": "The first payment is made at the beginning of each period."}, {"letter": "D", "text": "Compound interest is paid on all amounts in the annuity."}], "answer": "C", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 64, "prompt": "A is a periodic payment and I is the interest rate, then present worth of a perpetuity =", "choices": [{"letter": "A", "text": "Ai"}, {"letter": "B", "text": "Ai^n"}, {"letter": "C", "text": "A^n/i"}, {"letter": "D", "text": "A/i"}], "answer": "D", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 65, "prompt": "A mathematical expression also known as the present value of a n annuity of one called ______.", "choices": [{"letter": "A", "text": "load factor"}, {"letter": "B", "text": "demand factor"}, {"letter": "C", "text": "sinking fund"}, {"letter": "D", "text": "present worth factor"}], "answer": "D", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 66, "prompt": "As applied to a capitalized asset, the distribution of the initial cost by a periodic changes to operation as in depreciation or the reduction of a debt by either periodic or irregular prearranged program is called", "choices": [{"letter": "A", "text": "Annuity"}, {"letter": "B", "text": "capital recovery"}, {"letter": "C", "text": "annuity factor"}, {"letter": "D", "text": "amortization"}], "answer": "D", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 67, "prompt": "The reduction of the value of an asset due to constant use and passage of time.", "choices": [{"letter": "A", "text": "Scrap value"}, {"letter": "B", "text": "Depletion"}, {"letter": "C", "text": "Depreciation"}, {"letter": "D", "text": "Book value"}], "answer": "C", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 68, "prompt": "A method of computing depreciation in which the annual charge is a fixed percentage of the depreciation book value at the beginning of the year to which the depreciation applies.", "choices": [{"letter": "A", "text": "Straight line method"}, {"letter": "B", "text": "Sinking fund method"}, {"letter": "C", "text": "SYD method"}, {"letter": "D", "text": "Declining balance method"}], "answer": "D", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 69, "prompt": "A method of depreciation whereby the amount to recover is spread uniformly over the estimated life of the asset in terms of the periods or units of output.", "choices": [{"letter": "A", "text": "Straight line method"}, {"letter": "B", "text": "Sinking fund method"}, {"letter": "C", "text": "Declining balance method"}, {"letter": "D", "text": "SYD method"}], "answer": "A", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 70, "prompt": "Which of the following depreciation methods cannot have a salvage value of zero?", "choices": [{"letter": "A", "text": "Straight line method"}, {"letter": "B", "text": "Sinking fund method"}, {"letter": "C", "text": "Declining balance method"}, {"letter": "D", "text": "SYD method"}], "answer": "C", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 71, "prompt": "A method of depreciation where a fixed sum of money is regularly deposited at compound interest in a real or imaginary fund in order to accumulate an amount equal to the total depreciation of an asset at the end of the asset’s estimated life.", "choices": [{"letter": "A", "text": "Straight line method"}, {"letter": "B", "text": "Sinking fund method"}, {"letter": "C", "text": "Declining balance method"}, {"letter": "D", "text": "SYD method"}], "answer": "B", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 72, "prompt": "The function of interest rate and time that determines the cumulative amount of a sinking fund resulting from specific periodic deposits.", "choices": [{"letter": "A", "text": "Sinking fund factor"}, {"letter": "B", "text": "Present worth factor"}, {"letter": "C", "text": "Capacity factor"}, {"letter": "D", "text": "Demand factor"}], "answer": "A", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 73, "prompt": "The first cost of any property includes ______.", "choices": [{"letter": "A", "text": "the original purchase price and freight and transportation charges"}, {"letter": "B", "text": "installation expenses"}, {"letter": "C", "text": "initial taxes and permits fee"}, {"letter": "D", "text": "All of these"}], "answer": "D", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 74, "prompt": "In SYD method, the sum of years digit is calculated using the formula with n = number of useful years of the equipment.", "choices": [{"letter": "A", "text": "n(n-1)/2"}, {"letter": "B", "text": "n(n+1)/2"}, {"letter": "C", "text": "n(n+1)"}, {"letter": "D", "text": "n(n-1)"}], "answer": "B", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 75, "prompt": "Capitalized cost of any property is equal to the ______.", "choices": [{"letter": "A", "text": "annual cost"}, {"letter": "B", "text": "first cost + interest of the first cost"}, {"letter": "C", "text": "first cost + interest of perpetual maintenance"}, {"letter": "D", "text": "first cost + salvage value"}], "answer": "C", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 76, "prompt": "The lessening of the value of an asset due to the decrease in the quantity available (referring to the natural resources, coal, oil, etc.)", "choices": [{"letter": "A", "text": "Depreciation"}, {"letter": "B", "text": "depletion"}, {"letter": "C", "text": "inflation"}, {"letter": "D", "text": "incremental cost"}], "answer": "B", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 77, "prompt": "Is the simplest form a business organization.", "choices": [{"letter": "A", "text": "Sole proprietorship"}, {"letter": "B", "text": "Partnership"}, {"letter": "C", "text": "Enterprise"}, {"letter": "D", "text": "Corporation"}], "answer": "A", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 78, "prompt": "An association of two or more persons for a purpose of engaging in a profitable business.", "choices": [{"letter": "A", "text": "Sole proprietorship"}, {"letter": "B", "text": "Enterprise"}, {"letter": "C", "text": "Partnership"}, {"letter": "D", "text": "Corporation"}], "answer": "C", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 79, "prompt": "A distinct legal entity which can practically transact any business transaction which a real person could do.", "choices": [{"letter": "A", "text": "Sole of proprietorship"}, {"letter": "B", "text": "Enterprise"}, {"letter": "C", "text": "Partnership"}, {"letter": "D", "text": "Corporation"}], "answer": "D", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 80, "prompt": "Double taxation is a disadvantage of which business organization?", "choices": [{"letter": "A", "text": "Sole partnership"}, {"letter": "B", "text": "Partner"}, {"letter": "C", "text": "Corporation"}, {"letter": "D", "text": "Enterprise"}], "answer": "C", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 81, "prompt": "Which is NOT a type of business organization?", "choices": [{"letter": "A", "text": "Sole of proprietor"}, {"letter": "B", "text": "Corporation"}, {"letter": "C", "text": "Enterprise"}, {"letter": "D", "text": "Partnership"}], "answer": "C", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 82, "prompt": "What is the minimum number of incorporators in order that a corporation be organized?", "choices": [{"letter": "A", "text": "3"}, {"letter": "B", "text": "5"}, {"letter": "C", "text": "10"}, {"letter": "D", "text": "7"}], "answer": "B", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 83, "prompt": "In case of bankruptcy of a partnership,", "choices": [{"letter": "A", "text": "the partners are not liable for the liabilities of the partnership."}, {"letter": "B", "text": "The partnership assets 9excluding the partners personal assets) only will be used to pay the liabilities."}, {"letter": "C", "text": "the partners personal assets are attached to the debt of the partnership"}, {"letter": "D", "text": "the partners may sell stock to general additional capital"}], "answer": "C", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 84, "prompt": "Which is TRUE about partnership?", "choices": [{"letter": "A", "text": "It has a perpetual life."}, {"letter": "B", "text": "It will be dissolved if one of the partners ceases to be connected with the partnership."}, {"letter": "C", "text": "It can be handed down from one generation of partners to another."}, {"letter": "D", "text": "Its capitalization must be equal for each partner."}], "answer": "B", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 85, "prompt": "Which is TRUE about corporation?", "choices": [{"letter": "A", "text": "It is the not best form of business organization"}, {"letter": "B", "text": "The minimum number of incorporators to start a corporation is three."}, {"letter": "C", "text": "Its life is dependent on the lives of the incorporators."}, {"letter": "D", "text": "The stockholders of the corporation are only liable to the extent of their investments"}], "answer": "D", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 86, "prompt": "Represent ownership, and enjoys certain preferences than ordinary stock.", "choices": [{"letter": "A", "text": "Authorization capital stock"}, {"letter": "B", "text": "Preferred stock"}, {"letter": "C", "text": "Common stick"}, {"letter": "D", "text": "Incorporator’s stock"}], "answer": "B", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 87, "prompt": "Represent the ownership of stockholders who have a residual claim on the assets of the corporation after all other claims have been settled.", "choices": [{"letter": "A", "text": "Authorized capital stock."}, {"letter": "B", "text": "Preferred stock"}, {"letter": "C", "text": "Incorporators stock"}, {"letter": "D", "text": "Common stock"}], "answer": "D", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 88, "prompt": "The amount of company’s profit that the board of directors of the corporation decides to distribute to ordinary shareholders.", "choices": [{"letter": "A", "text": "Dividend"}, {"letter": "B", "text": "Return"}, {"letter": "C", "text": "Share stock"}, {"letter": "D", "text": "Par value"}], "answer": "A", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 89, "prompt": "A certificate of indebtedness of a corporation usually for a period not less than 10 years and guaranteed by a mortgage on certain assets of the corporation.", "choices": [{"letter": "A", "text": "Bond"}, {"letter": "B", "text": "T-bill"}, {"letter": "C", "text": "Preferred stock"}, {"letter": "D", "text": "Common stock"}], "answer": "A", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 90, "prompt": "A form of fixed-interest security issued by central or local government, companies, banks or other institutions. They are usually a form of long-term security, buy may be irredeemable, secured or unsecured.", "choices": [{"letter": "A", "text": "Bond"}, {"letter": "B", "text": "T-bills"}, {"letter": "C", "text": "Certificate of deposit"}, {"letter": "D", "text": "All of these"}], "answer": "A", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 91, "prompt": "A type of bind where the corporation pledges securities which it owns (i.e. stocks, bonds of its subsidiaries).", "choices": [{"letter": "A", "text": "Mortgage"}, {"letter": "B", "text": "Registered bond"}, {"letter": "C", "text": "Coupon bond"}, {"letter": "D", "text": "Collateral trust bond"}], "answer": "D", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 92, "prompt": "A type of bond which does not have security except a promise to pay by the issuing corporation.", "choices": [{"letter": "A", "text": "Mortgage bond"}, {"letter": "B", "text": "Registered bond"}, {"letter": "C", "text": "Collateral trust bond"}, {"letter": "D", "text": "Debenture bond"}], "answer": "D", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 93, "prompt": "A type of bond issued jointly by two or more corporations.", "choices": [{"letter": "A", "text": "Joint bond"}, {"letter": "B", "text": "Debenture bond"}, {"letter": "C", "text": "Registered bond"}, {"letter": "D", "text": "Collateral trust bond"}], "answer": "A", "note": "Sourced from elements_in_economics.md[cite: 8]"},
