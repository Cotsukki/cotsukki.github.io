    {"id": 1, "prompt": "Which one of the following contains only items which are considered fixed charges?", "choices": [{"letter": "A", "text": "Interest, taxes, amortization, insurance, rent"}, {"letter": "B", "text": "Amortization, insurance, steam cost, painting, cleaning"}, {"letter": "C", "text": "Interest, taxes, replacements, labor for repairs"}, {"letter": "D", "text": "Interest, taxes, rent, power cost, oil cost"}], "answer": "A", "note": "Sourced from elements_in_economics.md[cite: 8]"},
