    {"id": 5, "prompt": "The place where buyers and sellers come together.", "choices": [{"letter": "A", "text": "Market"}, {"letter": "B", "text": "Business"}, {"letter": "C", "text": "Recreation center"}, {"letter": "D", "text": "Buy and sell section"}], "answer": "A", "note": "Sourced from elements_in_economics.md[cite: 8]"},
    {"id": 6, "prompt": "A market whereby there is only one buyer of an item for which there are no good substitute.", "choices": [{"letter": "A", "text": "Monopsony"}, {"letter": "B", "text": "Oligopoly"}, {"letter": "C", "text": "Monopoly"}, {"letter": "D", "text": "Oligopsony"}], "answer": "A", "note": "Sourced from elements_in_economics.md[cite: 8]"},
