    {"id": 3, "prompt": "Reduction in the level of national income and output usually accompanied by the fall in the general price level.", "choices": [{"letter": "A", "text": "devaluation"}, {"letter": "B", "text": "deflation"}, {"letter": "C", "text": "inflation"}, {"letter": "D", "text": "depreciation"}], "answer": "B", "note": "Sourced from elements_in_economics.md[cite: 8]"},
