{
  "topic": "Mechanics & Strength of Materials",
  "questions": [
    {"id": 1, "prompt": "A branch of physical science which deals with state of rest or motion of bodies under the action of forces.", "choices": [{"letter": "A", "text": "Mechanics"}, {"letter": "B", "text": "Kinematics"}, {"letter": "C", "text": "Kinematics"}, {"letter": "D", "text": "Statics"}], "answer": "A", "note": "Sourced from elements_in_strema.md[cite: 10]"},
    {"id": 2, "prompt": "A branch of mechanics which deals with bodies at rest.", "choices": [{"letter": "A", "text": "Statics"}, {"letter": "B", "text": "Dynamics"}, {"letter": "C", "text": "Kinetics"}, {"letter": "D", "text": "Kinematics"}], "answer": "A", "note": "Sourced from elements_in_strema.md[cite: 10]"},
    {"id": 3, "prompt": "Branch of mechanics which deals with bodies in motion.", "choices": [{"letter": "A", "text": "Statics"}, {"letter": "B", "text": "Dynamics"}, {"letter": "C", "text": "Kinetics"}, {"letter": "D", "text": "Kinematics"}], "answer": "B", "note": "Sourced from elements_in_strema.md[cite: 10]"},
    {"id": 4, "prompt": "The action of a force is characterized by", "choices": [{"letter": "A", "text": "its magnitude"}, {"letter": "B", "text": "the direction of its action"}, {"letter": "C", "text": "point of application"}, {"letter": "D", "text": "All of these"}], "answer": "D", "note": "Sourced from elements_in_strema.md[cite: 10]"},
    {"id": 5, "prompt": "For a system to be in equilibrium", "choices": [{"letter": "A", "text": "the force polygon must close"}, {"letter": "B", "text": "all forces must be concurrent, if not acting parallel"}, {"letter": "C", "text": "it must satisfy the 3 static equations"}, {"letter": "D", "text": "All of these"}], "answer": "D", "note": "Sourced from elements_in_strema.md[cite: 10]"},
    {"id": 6, "prompt": "A motion with reference to the force which causes the motion is", "choices": [{"letter": "A", "text": "statics"}, {"letter": "B", "text": "dynamics"}, {"letter": "C", "text": "kinetics"}, {"letter": "D", "text": "kinematics"}], "answer": "C", "note": "Sourced from elements_in_strema.md[cite: 10]"},
    {"id": 7, "prompt": "Momentum is a property related to the objects", "choices": [{"letter": "A", "text": "motion and mass"}, {"letter": "B", "text": "mass and acceleration"}, {"letter": "C", "text": "motion and velocity"}, {"letter": "D", "text": "weight and velocity"}], "answer": "A", "note": "Sourced from elements_in_strema.md[cite: 10]"},
    {"id": 8, "prompt": "An impulse causes", "choices": [{"letter": "A", "text": "the object's momentum to change"}, {"letter": "B", "text": "the object's momentum to decrease"}, {"letter": "C", "text": "the object's momentum to increase"}, {"letter": "D", "text": "the object's momentum to remain constant or be conserved"}], "answer": "A", "note": "Sourced from elements_in_strema.md[cite: 10]"},
    {"id": 9, "prompt": "Centrifugal force is", "choices": [{"letter": "A", "text": "directly proportional to the radius of the curvature."}, {"letter": "B", "text": "directly proportional to the square of the tangential velocity"}, {"letter": "C", "text": "inversely proportional to the square of the tangential velocity"}, {"letter": "D", "text": "directly proportional to the square of the weight of the object"}], "answer": "B", "note": "Sourced from elements_in_strema.md[cite: 10]"},
    {"id": 10, "prompt": "A measure of the resistance of a body it offers to any change in its angular velocity, determined by the mass and distribution of its mass about the axis of rotation is known as", "choices": [{"letter": "A", "text": "moment of inertia"}, {"letter": "B", "text": "torsion"}, {"letter": "C", "text": "friction"}, {"letter": "D", "text": "angular acceleration"}], "answer": "D", "note": "Sourced from elements_in_strema.md[cite: 10]"},
    {"id": 11, "prompt": "Momentum is the product of mass and", "choices": [{"letter": "A", "text": "acceleration"}, {"letter": "B", "text": "velocity"}, {"letter": "C", "text": "force"}, {"letter": "D", "text": "time"}], "answer": "B", "note": "Sourced from elements_in_strema.md[cite: 10]"},
    {"id": 12, "prompt": "The moment of inertia of a plane figure,", "choices": [{"letter": "A", "text": "increases as distance of the axis moves farther from the centroid"}, {"letter": "B", "text": "is maximum at the centroidal axis"}, {"letter": "C", "text": "is zero at the centroidal axis"}, {"letter": "D", "text": "decreases as the distance of the axis moves farther from the centroid"}], "answer": "A", "note": "Sourced from elements_in_strema.md[cite: 10]"},
    {"id": 13, "prompt": "To maximize the horizontal range of the projectile, which of the following applies?", "choices": [{"letter": "A", "text": "Maximize velocity"}, {"letter": "B", "text": "Maximize the angle of elevation"}, {"letter": "C", "text": "Maximize the angle of elevation"}, {"letter": "D", "text": "The tangent function of the angle and velocity of trajectory must be equal to 1"}], "answer": "D", "note": "Sourced from elements_in_strema.md[cite: 10]"},
    {"id": 14, "prompt": "Moment of inertia of any plane figure is expressed in units of length of the", "choices": [{"letter": "A", "text": "first power"}, {"letter": "B", "text": "second power"}, {"letter": "C", "text": "third power"}, {"letter": "D", "text": "fourth power"}], "answer": "D", "note": "Sourced from elements_in_strema.md[cite: 10]"},
    {"id": 15, "prompt": "A pair of forces equal in magnitude, opposite in direction, and not in the same line is called", "choices": [{"letter": "A", "text": "moment"}, {"letter": "B", "text": "torque"}, {"letter": "C", "text": "couple"}, {"letter": "D", "text": "All of these ."}], "answer": "C", "note": "Sourced from elements_in_strema.md[cite: 10]"},
    {"id": 16, "prompt": "The ______ exerted by a force on a body is the measure of its effectiveness in turning the body about a certain pivot.", "choices": [{"letter": "A", "text": "couple"}, {"letter": "B", "text": "torque"}, {"letter": "C", "text": "moment arm"}, {"letter": "D", "text": "All of these"}], "answer": "B", "note": "Sourced from elements_in_strema.md[cite: 10]"},
    {"id": 17, "prompt": "A body is said to be in \"rotational equilibrium\" when", "choices": [{"letter": "A", "text": "no net torque acts on it"}, {"letter": "B", "text": "no net force acts on it"}, {"letter": "C", "text": "its vector sum of the forces is zero"}, {"letter": "D", "text": "the forces acting on the body are non-concurrent"}], "answer": "A", "note": "Sourced from elements_in_strema.md[cite: 10]"},
    {"id": 18, "prompt": "A couple consists of two forces, ______ in magnitude, parallel and oppositely directed.", "choices": [{"letter": "A", "text": "directly proportional"}, {"letter": "B", "text": "equal"}, {"letter": "C", "text": "unequal"}, {"letter": "D", "text": "inversely proportional"}], "answer": "B", "note": "Sourced from elements_in_strema.md[cite: 10]"},
    {"id": 19, "prompt": "The ______ of the body or system is the point about with the product of the mass and moment arm sums up to zero.", "choices": [{"letter": "A", "text": "center of gravity"}, {"letter": "B", "text": "center of mass"}, {"letter": "C", "text": "centroid"}, {"letter": "D", "text": "All of these"}], "answer": "B", "note": "Sourced from elements_in_strema.md[cite: 10]"},
    {"id": 20, "prompt": "The point through which the resultant of the distributed gravity force passes regardless the orientation of the body is space.", "choices": [{"letter": "A", "text": "Center of inertia"}, {"letter": "B", "text": "Center of mass"}, {"letter": "C", "text": "Centerpoint"}, {"letter": "D", "text": "Center of gravity"}], "answer": "D", "note": "Sourced from elements_in_strema.md[cite: 10]"},
    {"id": 21, "prompt": "If an object exerts a normal force on a surface, then its normal force is", "choices": [{"letter": "A", "text": "equal to the weight of the object"}, {"letter": "B", "text": "less than the frictional force"}, {"letter": "C", "text": "parallel to the surface"}, {"letter": "D", "text": "perpendicular to the surface"}], "answer": "D", "note": "Sourced from elements_in_strema.md[cite: 10]"},
    {"id": 22, "prompt": "Whenever the surfaces of two bodies are in contact, there will be a limiting amount resistance to sliding between them. This is known as", "choices": [{"letter": "A", "text": "friction"}, {"letter": "B", "text": "coefficient of friction"}, {"letter": "C", "text": "angle of friction"}, {"letter": "D", "text": "coefficient of sliding"}], "answer": "A", "note": "Sourced from elements_in_strema.md[cite: 10]"},
    {"id": 23, "prompt": "The moment of inertia of a triangle with respect to the base b is", "choices": [{"letter": "A", "text": "bh³/12"}, {"letter": "B", "text": "bh³/6"}, {"letter": "C", "text": "bh³/36"}, {"letter": "D", "text": "bh³/3"}], "answer": "A", "note": "Sourced from elements_in_strema.md[cite: 10]"},
    {"id": 24, "prompt": "The moment of inertia f a triangle with respect to the base is ______ time its moment of inertia with respect to its centroidal axis?", "choices": [{"letter": "A", "text": "2"}, {"letter": "B", "text": "3"}, {"letter": "C", "text": "4"}, {"letter": "D", "text": "5"}], "answer": "B", "note": "Sourced from elements_in_strema.md[cite: 10]"},
    {"id": 25, "prompt": "What is the moment of inertia of a circle of", "choices": [{"letter": "A", "text": "π/16"}, {"letter": "B", "text": "π/2"}, {"letter": "C", "text": "π/24"}, {"letter": "D", "text": "π/4"}], "answer": "D", "note": "Sourced from elements_in_strema.md[cite: 10]"},
    {"id": 26, "prompt": "The moment of inertia of the circle with respect to its tangent is ______ times its centroidal moment of inertia.", "choices": [{"letter": "A", "text": "2"}, {"letter": "B", "text": "3"}, {"letter": "C", "text": "4"}, {"letter": "D", "text": "5"}], "answer": "D", "note": "Sourced from elements_in_strema.md[cite: 10]"},
    {"id": 27, "prompt": "The moment of inertia of a rectangle with respect to the base is ______ times its moment of inertia with respect to the centroid.", "choices": [{"letter": "A", "text": "2"}, {"letter": "B", "text": "3"}, {"letter": "C", "text": "4"}, {"letter": "D", "text": "5"}], "answer": "C", "note": "Sourced from elements_in_strema.md[cite: 10]"},
    {"id": 28, "prompt": "What is the mass moment of inertia of a sphere of mass m and radius r?", "choices": [{"letter": "A", "text": "½ mr²"}, {"letter": "B", "text": "mr²"}, {"letter": "C", "text": "1/3 mr²"}, {"letter": "D", "text": "2/5 mr²"}], "answer": "D", "note": "Sourced from elements_in_strema.md[cite: 10]"},
    {"id": 29, "prompt": "Given a cylinder of radius r, altitude h and mass m. What is its mass of inertia?", "choices": [{"letter": "A", "text": "12 mr²"}, {"letter": "B", "text": "¼ mr²"}, {"letter": "C", "text": "1/3 mr²"}, {"letter": "D", "text": "2/5 mr²"}], "answer": "A", "note": "Sourced from elements_in_strema.md[cite: 10]"},
    {"id": 30, "prompt": "A structure is called ______ if at least one of its individual members is a multi-force member.", "choices": [{"letter": "A", "text": "Truss"}, {"letter": "B", "text": "frame"}, {"letter": "C", "text": "three-hinged arch"}, {"letter": "D", "text": "bridge"}], "answer": "B", "note": "Sourced from elements_in_strema.md[cite: 10]"},
    {"id": 31, "prompt": "Another term of moment of inertia.", "choices": [{"letter": "A", "text": "Moment of area"}, {"letter": "B", "text": "Second moment of area"}, {"letter": "C", "text": "Moment of mass"}, {"letter": "D", "text": "First moment"}], "answer": "B", "note": "Sourced from elements_in_strema.md[cite: 10]"},
    {"id": 32, "prompt": "The diagram of an isolated body with the representation of all external forces acting on it is called", "choices": [{"letter": "A", "text": "Maxwell diagram"}, {"letter": "B", "text": "stress-strain diagram"}, {"letter": "C", "text": "free body diagram"}, {"letter": "D", "text": "shear and moment diagram"}], "answer": "C", "note": "Sourced from elements_in_strema.md[cite: 10]"},
    {"id": 33, "prompt": "A framework composed of members joined at their ends to form a rigid structure.", "choices": [{"letter": "A", "text": "Machine"}, {"letter": "B", "text": "Truss"}, {"letter": "C", "text": "Joist"}, {"letter": "D", "text": "Purlin"}], "answer": "B", "note": "Sourced from elements_in_strema.md[cite: 10]"},
    {"id": 34, "prompt": "The moment of the resultant of two concurrent forces with respect to a center of their planes is equal to the algebraic sum of the moments of the components with respect to the same center.", "choices": [{"letter": "A", "text": "Law of reaction"}, {"letter": "B", "text": "Varignon's theorem"}, {"letter": "C", "text": "Mass moment of inertia."}, {"letter": "D", "text": "Law of inertia"}], "answer": "B", "note": "Sourced from elements_in_strema.md[cite: 10]"},
    {"id": 35, "prompt": "The condition exist | structures where the reactive forces exceed the number of independent equations for equilibrium. Such case is called", "choices": [{"letter": "A", "text": "statically determine"}, {"letter": "B", "text": "statically indeterminate"}, {"letter": "C", "text": "static equilibrium"}, {"letter": "D", "text": "none of these"}], "answer": "B", "note": "Sourced from elements_in_strema.md[cite: 10]"},
    {"id": 36, "prompt": "Two lengths of a steel wire are used to support a chandelier of weight A. The tension in the wire must", "choices": [{"letter": "A", "text": "each be W/2"}, {"letter": "B", "text": "each be W"}, {"letter": "C", "text": "have a vector sum of magnitude W"}, {"letter": "D", "text": "have a vector sum of magnitude >W"}], "answer": "C", "note": "Sourced from elements_in_strema.md[cite: 10]"},
    {"id": 37, "prompt": "The built-in or fixed support is capable of supporting", "choices": [{"letter": "A", "text": "an axial load"}, {"letter": "B", "text": "a transverse load"}, {"letter": "C", "text": "a bending moment"}, {"letter": "D", "text": "All of these"}], "answer": "D", "note": "Sourced from elements_in_strema.md[cite: 10]"},
    {"id": 38, "prompt": "Which of the following BEST describes d'Alembert's principle?", "choices": [{"letter": "A", "text": "F = ma"}, {"letter": "B", "text": "First law of motion"}, {"letter": "C", "text": "Stress is directly proportional to strain"}, {"letter": "D", "text": "F = kx"}], "answer": "A", "note": "Sourced from elements_in_strema.md[cite: 10]"},
    {"id": 39, "prompt": "The theorem which is closely related to d'Alembert's theorem is the", "choices": [{"letter": "A", "text": "Newton's first law of motion"}, {"letter": "B", "text": "Newton's third law of motion"}, {"letter": "C", "text": "Newton's second law of motion"}, {"letter": "D", "text": "Bernoulli's theorem"}], "answer": "C", "note": "Sourced from elements_in_strema.md[cite: 10]"},
    {"id": 40, "prompt": "______ is the quality of being plastically elongated.", "choices": [{"letter": "A", "text": "Flexibility"}, {"letter": "B", "text": "Plasticity"}, {"letter": "C", "text": "Malleability"}, {"letter": "D", "text": "Ductility"}], "answer": "B", "note": "Sourced from elements_in_strema.md[cite: 10]"},
    {"id": 41, "prompt": "It is the ratio of the ultimate stress to the allowable stress.", "choices": [{"letter": "A", "text": "Proportionality constant"}, {"letter": "B", "text": "Strain"}, {"letter": "C", "text": "Factor of safety"}, {"letter": "D", "text": "Modulus"}], "answer": "C", "note": "Sourced from elements_in_strema.md[cite: 10]"},
    {"id": 42, "prompt": "The greatest unit pressure the soil can continuously stand is called", "choices": [{"letter": "A", "text": "bearing strength"}, {"letter": "B", "text": "yield strength"}, {"letter": "C", "text": "ultimate strength"}, {"letter": "D", "text": "fatigue strength"}], "answer": "A", "note": "Sourced from elements_in_strema.md[cite: 10]"},
    {"id": 43, "prompt": "The distance that the top surface is displaced in the direction of the force divided by the thickness of the body is known as", "choices": [{"letter": "A", "text": "longitudinal strain"}, {"letter": "B", "text": "linear strain"}, {"letter": "C", "text": "shear strain"}, {"letter": "D", "text": "volume strain"}], "answer": "C", "note": "Sourced from elements_in_strema.md[cite: 10]"},
    {"id": 44, "prompt": "The ratio of the tensile stress to tensile strain.:", "choices": [{"letter": "A", "text": "Shear modulus"}, {"letter": "B", "text": "Modulus of elasticity"}, {"letter": "C", "text": "Bulk modulus"}, {"letter": "D", "text": "Hooke's law"}], "answer": "B", "note": "Sourced from elements_in_strema.md[cite: 10]"},
    {"id": 45, "prompt": "Another term for modulus of elasticity.", "choices": [{"letter": "A", "text": "Bulk modulus"}, {"letter": "B", "text": "Shear modulus"}, {"letter": "C", "text": "Young's modulus"}, {"letter": "D", "text": "Moment of inertia"}], "answer": "C", "note": "Sourced from elements_in_strema.md[cite: 10]"},
    {"id": 46, "prompt": "What is the value of the modulus of elasticity of steel?", "choices": [{"letter": "A", "text": "200 GPa"}, {"letter": "B", "text": "200 MPa"}, {"letter": "C", "text": "150 Mpa"}, {"letter": "D", "text": "150 GPa"}], "answer": "A", "note": "Sourced from elements_in_strema.md[cite: 10]"},
