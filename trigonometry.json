{
  "topic": "Trigonometry",
  "questions": [
    {"id": 1, "prompt": "Sin A cos B − cos A sin B is equivalent to __________.", "choices": [{"letter": "A", "text": "cos(A − B)"}, {"letter": "B", "text": "sin(A − B)"}, {"letter": "C", "text": "tan(A − B)"}, {"letter": "D", "text": "cos2(A − B)"}], "answer": "B", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 2, "prompt": "The angular distance of a point on the terrestrial sphere from the north pole is called__________.", "choices": [{"letter": "A", "text": "coaltitude"}, {"letter": "B", "text": "latitude"}, {"letter": "C", "text": "altitude"}, {"letter": "D", "text": "codeclination"}], "answer": "A", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 3, "prompt": "Csc 520° is equal to__________.", "choices": [{"letter": "A", "text": "cos 20°"}, {"letter": "B", "text": "csc 20°"}, {"letter": "C", "text": "tan 45°"}, {"letter": "D", "text": "sin 20°"}], "answer": "B", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 4, "prompt": "What is the sine of 820°?", "choices": [{"letter": "A", "text": "0.984"}, {"letter": "B", "text": "0.866"}, {"letter": "C", "text": "-0.866"}, {"letter": "D", "text": "-0.5"}], "answer": "A", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 5, "prompt": "The logarithm of the negative number is __________.", "choices": [{"letter": "A", "text": "imaginary"}, {"letter": "B", "text": "irrational"}, {"letter": "C", "text": "real"}, {"letter": "D", "text": "rational"}], "answer": "A", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 6, "prompt": "The sum of the squares of the sine and cosine of an angle..", "choices": [{"letter": "A", "text": "0"}, {"letter": "B", "text": "1"}, {"letter": "C", "text": "2"}, {"letter": "D", "text": "3"}], "answer": "B", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 7, "prompt": "The logarithm of a number to the base e (2.7182....) is called _____.", "choices": [{"letter": "A", "text": "Napierian logarithm"}, {"letter": "B", "text": "Characteristic"}, {"letter": "C", "text": "Mantissa"}, {"letter": "D", "text": "Briggsian logarithm"}], "answer": "A", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 8, "prompt": "The characteristic is equal to the exponent of 10, when the number is written in ________.", "choices": [{"letter": "A", "text": "exponential form"}, {"letter": "B", "text": "scientific notation"}, {"letter": "C", "text": "logarithmic form"}, {"letter": "D", "text": "irrational number"}], "answer": "C", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 9, "prompt": "Napierian logarithms have a base closest to which number?", "choices": [{"letter": "A", "text": "2.72"}, {"letter": "B", "text": "2.82"}, {"letter": "C", "text": "2.92"}, {"letter": "D", "text": "10"}], "answer": "A", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 10, "prompt": "The logarithm of 1 to any base is __________.", "choices": [{"letter": "A", "text": "indeterminate"}, {"letter": "B", "text": "zero"}, {"letter": "C", "text": "infinity"}, {"letter": "D", "text": "one"}], "answer": "B", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 11, "prompt": "Sin (270° + β) is equal to _____.", "choices": [{"letter": "A", "text": "-cos β"}, {"letter": "B", "text": "sin β"}, {"letter": "C", "text": "-sin β"}, {"letter": "D", "text": "cos β"}], "answer": "A", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 12, "prompt": "The sum of the angles in an octant spheric triangle is __________.", "choices": [{"letter": "A", "text": "180°"}, {"letter": "B", "text": "270°"}, {"letter": "C", "text": "360°"}, {"letter": "D", "text": "540°"}], "answer": "B", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 13, "prompt": "The median of a triangle is the line connecting the vertex and the midpoint of the opposite side. For a given triangle, these medians intersects at a point which is called the__________.", "choices": [{"letter": "A", "text": "orthocenter"}, {"letter": "B", "text": "circumcenter"}, {"letter": "C", "text": "centroid"}, {"letter": "D", "text": "incenter"}], "answer": "C", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 14, "prompt": "The altitudes of the sides of the triangle intersects at the point known as __________.", "choices": [{"letter": "A", "text": "orthocenter"}, {"letter": "B", "text": "circumcenter"}, {"letter": "C", "text": "incenter"}, {"letter": "D", "text": "centroid"}], "answer": "A", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 15, "prompt": "The angle which the line of sight to the object makes with the horizontal which is above the eye of the observer is called", "choices": [{"letter": "A", "text": "angle of depression"}, {"letter": "B", "text": "angle of elevation"}, {"letter": "C", "text": "acute angle"}, {"letter": "D", "text": "bearing"}], "answer": "B", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 16, "prompt": "Log M − log N id equal to __________.", "choices": [{"letter": "A", "text": "log MN"}, {"letter": "B", "text": "log (M − N)"}, {"letter": "C", "text": "log M/N"}, {"letter": "D", "text": "log (N − M)"}], "answer": "C", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 17, "prompt": "The other form of logₐ N = b is", "choices": [{"letter": "A", "text": "N = bᵃ"}, {"letter": "B", "text": "N = aᵇ"}, {"letter": "C", "text": "N = ab"}, {"letter": "D", "text": "N = a/b"}], "answer": "B", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 18, "prompt": "The point of concurrency of the altitude of the triangle.", "choices": [{"letter": "A", "text": "orthocenter"}, {"letter": "B", "text": "centroid"}, {"letter": "C", "text": "metacenter"}, {"letter": "D", "text": "incenter"}], "answer": "A", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 19, "prompt": "The point of concurrency of the perpendicular bisector of the sides of the triangle.", "choices": [{"letter": "A", "text": "orthocenter"}, {"letter": "B", "text": "circumcenter"}, {"letter": "C", "text": "centroid"}, {"letter": "D", "text": "incenter"}], "answer": "B", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 20, "prompt": "The point of concurrency of the angle bisector of the triangle is called", "choices": [{"letter": "A", "text": "orthocenter"}, {"letter": "B", "text": "circumcenter"}, {"letter": "C", "text": "centroid"}, {"letter": "D", "text": "incnter"}], "answer": "D", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 21, "prompt": "The logarithm of the reciprocal of N is called the ______ of N.", "choices": [{"letter": "A", "text": "antilogarithm"}, {"letter": "B", "text": "cologarithm"}, {"letter": "C", "text": "natural logarithm"}, {"letter": "D", "text": "Briggsian logarithm"}], "answer": "B", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 22, "prompt": "The inverse function of a logarithm is known as __________.", "choices": [{"letter": "A", "text": "antilogarithm"}, {"letter": "B", "text": "cologarithm"}, {"letter": "C", "text": "antideravative"}, {"letter": "D", "text": "antecendent"}], "answer": "A", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 23, "prompt": "The cologarithm of a number is the ______ of the logarithm of a number.", "choices": [{"letter": "A", "text": "positive"}, {"letter": "B", "text": "absolute value"}, {"letter": "C", "text": "negative"}, {"letter": "D", "text": "reciprocal"}], "answer": "C", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 24, "prompt": "The first table logarithms with 10 as base was developed in 1615 by", "choices": [{"letter": "A", "text": "James Naismith"}, {"letter": "B", "text": "Henry Briggs"}, {"letter": "C", "text": "John Napier"}, {"letter": "D", "text": "John Wallis"}], "answer": "B", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 25, "prompt": "Who invented logarithms in 1614?", "choices": [{"letter": "A", "text": "John Wallis"}, {"letter": "B", "text": "Henry Briggs"}, {"letter": "C", "text": "John Napier"}, {"letter": "D", "text": "L’Hospital"}], "answer": "C", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 26, "prompt": "The number logₐ b is called the _____ of the system of a base a with respect to the system of base b.", "choices": [{"letter": "A", "text": "coefficient"}, {"letter": "B", "text": "logarithm"}, {"letter": "C", "text": "modulus"}, {"letter": "D", "text": "exponent"}], "answer": "C", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 27, "prompt": "Napierian logarithm has a base of__________.", "choices": [{"letter": "A", "text": "π"}, {"letter": "B", "text": "10"}, {"letter": "C", "text": "1"}, {"letter": "D", "text": "e"}], "answer": "D", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 28, "prompt": "Log x = _____ ln x.", "choices": [{"letter": "A", "text": "0.434"}, {"letter": "B", "text": "10"}, {"letter": "C", "text": "2.303"}, {"letter": "D", "text": "e"}], "answer": "A", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 29, "prompt": "ln x = _____ log x.", "choices": [{"letter": "A", "text": "0.434"}, {"letter": "B", "text": "10"}, {"letter": "C", "text": "2.303"}, {"letter": "D", "text": "e"}], "answer": "C", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 30, "prompt": "Which of the following cannot be a base for a logarithm?", "choices": [{"letter": "A", "text": "10"}, {"letter": "B", "text": "π"}, {"letter": "C", "text": "1"}, {"letter": "D", "text": "e"}], "answer": "C", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 31, "prompt": "The integral part of a common logarithm is __________.", "choices": [{"letter": "A", "text": "10"}, {"letter": "B", "text": "e"}, {"letter": "C", "text": "mantissa"}, {"letter": "D", "text": "characteristic"}], "answer": "D", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 32, "prompt": "The mantissa of a logarithm is a __________.", "choices": [{"letter": "A", "text": "positive value only"}, {"letter": "B", "text": "negative value only"}, {"letter": "C", "text": "positive value, negative value or zero"}, {"letter": "D", "text": "positive value or zero"}], "answer": "D", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 33, "prompt": "For 0 < x < 1, ln x is __________.", "choices": [{"letter": "A", "text": "positive"}, {"letter": "B", "text": "zero"}, {"letter": "C", "text": "negative"}, {"letter": "D", "text": "between 0 and 1"}], "answer": "C", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 34, "prompt": "If 1 < N < 10, then__________.", "choices": [{"letter": "A", "text": "1 < log N < 2"}, {"letter": "B", "text": "0 < log N < 1"}, {"letter": "C", "text": "2 < log N < 3"}, {"letter": "D", "text": "-1 < log N < 0"}], "answer": "B", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 35, "prompt": "To change logₐ to log_b N, multiply logₐ N by", "choices": [{"letter": "A", "text": "logₐ b"}, {"letter": "B", "text": "log_b a"}, {"letter": "C", "text": "log_N a"}, {"letter": "D", "text": "log_N b"}], "answer": "B", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 36, "prompt": "The numbers logₐ b and log_b a are", "choices": [{"letter": "A", "text": "equal"}, {"letter": "B", "text": "equal but different in signs"}, {"letter": "C", "text": "reciprocal to each other"}, {"letter": "D", "text": "negative reciprocal to each other"}], "answer": "C", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 37, "prompt": "Logarithm using 10 as base.", "choices": [{"letter": "A", "text": "Decimal logarithm"}, {"letter": "B", "text": "Scientific logarithm"}, {"letter": "C", "text": "Common logarithm"}, {"letter": "D", "text": "Natural logarithm"}], "answer": "C", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 38, "prompt": "The logarithm of a product is the ______ of the logarithms, and the logarithm of a quotient is the ______ of the logarithms.", "choices": [{"letter": "A", "text": "sum, difference"}, {"letter": "B", "text": "difference, sum"}, {"letter": "C", "text": "quotient, product"}, {"letter": "D", "text": "product, quotient"}], "answer": "A", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 39, "prompt": "When a logarithm is expressed as an integer plus a decimal (between 0 and 1), the integer is called", "choices": [{"letter": "A", "text": "Briggsian logarithm"}, {"letter": "B", "text": "Napierian logarithm"}, {"letter": "C", "text": "Mantissa"}, {"letter": "D", "text": "Characteristic"}], "answer": "D", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 40, "prompt": "The characteristic of a logarithm is 3. The number between ______.", "choices": [{"letter": "A", "text": "1 and 10"}, {"letter": "B", "text": "10 and 100"}, {"letter": "C", "text": "100 and 1000"}, {"letter": "D", "text": "1000 and 10000"}], "answer": "D", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 41, "prompt": "The characteristics of the common logarithm of a number greater than 1 is __________.", "choices": [{"letter": "A", "text": "zero"}, {"letter": "B", "text": "positive"}, {"letter": "C", "text": "negative"}, {"letter": "D", "text": "zero or positive"}], "answer": "D", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 42, "prompt": "The characteristic is ______ the exponent of 10, when the number is written in scientific notation.", "choices": [{"letter": "A", "text": "equal to"}, {"letter": "B", "text": "greater than"}, {"letter": "C", "text": "less than"}, {"letter": "D", "text": "none of these"}], "answer": "A", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 43, "prompt": "If logarithm to base 10 (denoted as log₁₀) is called common logarithm is called natural logarithm, what do you call the logarithm of base 2 (denotes as lb)?", "choices": [{"letter": "A", "text": "Binary logarithm"}, {"letter": "B", "text": "Bit logarithm"}, {"letter": "C", "text": "Bilogarithm"}, {"letter": "D", "text": "All of these"}], "answer": "A", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 44, "prompt": "If the unknown is a conditional equation occurs as an exponent, the best way to solve the unknown is by__________.", "choices": [{"letter": "A", "text": "raising the power of both sides"}, {"letter": "B", "text": "taking the logarithm of both sides"}, {"letter": "C", "text": "extracting the root of both sides"}, {"letter": "D", "text": "applying the Newton’s method"}], "answer": "B", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 45, "prompt": "Angles of rotation with the same initial side and terminal side.", "choices": [{"letter": "A", "text": "Terminal angles"}, {"letter": "B", "text": "Conjugate angles"}, {"letter": "C", "text": "Coterminal angle"}, {"letter": "D", "text": "Supplementary angles"}], "answer": "C", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 46, "prompt": "An angle equal to one revolution of 360°", "choices": [{"letter": "A", "text": "Perigon"}, {"letter": "B", "text": "Explement Angle"}, {"letter": "C", "text": "Reflex angle"}, {"letter": "D", "text": "Supplement angle"}], "answer": "A", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 47, "prompt": "The angle which the line of sight to the object makes with the horizontal is above the eye of an observer.", "choices": [{"letter": "A", "text": "Angle of depression"}, {"letter": "B", "text": "Angle of elevation"}, {"letter": "C", "text": "Acute angle"}, {"letter": "D", "text": "Bearing"}], "answer": "B", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 48, "prompt": "The angle which the line of sight to the object makes with the horizontal is below the eye of an observer.", "choices": [{"letter": "A", "text": "Angle of depression"}, {"letter": "B", "text": "Angle of elevation"}, {"letter": "C", "text": "Acute angle"}, {"letter": "D", "text": "Bearing"}], "answer": "A", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 49, "prompt": "A triangle inscribed in a given triangle whose vertices are the feet of the three perpendiculars to the sides from same point inside, the given triangle.", "choices": [{"letter": "A", "text": "Inscribed triangle"}, {"letter": "B", "text": "Primitive triangle"}, {"letter": "C", "text": "Pedal triangle"}, {"letter": "D", "text": "Obtuse triangle"}], "answer": "C", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 50, "prompt": "The triangle with minimum perimeter but maximum area inscribed in another triangle is known as ________.", "choices": [{"letter": "A", "text": "Pedal triangle"}, {"letter": "B", "text": "Euclid’s triangle"}, {"letter": "C", "text": "Primitive triangle"}, {"letter": "D", "text": "None of these"}], "answer": "A", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 51, "prompt": "A right triangle whose length of sides may be expressed as ratio of integral units.", "choices": [{"letter": "A", "text": "Pedal triangle"}, {"letter": "B", "text": "Isosceles triangle"}, {"letter": "C", "text": "Scalene triangle"}, {"letter": "D", "text": "Primitive triangle"}], "answer": "D", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 52, "prompt": "How do you call a triangle with no side equal?", "choices": [{"letter": "A", "text": "acute triangle"}, {"letter": "B", "text": "oblique triangle"}, {"letter": "C", "text": "equilateral triangle"}, {"letter": "D", "text": "scalene triangle"}], "answer": "D", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 53, "prompt": "If two triangles have congruent bases, then the ratio of their areas equals the ratio of ________.", "choices": [{"letter": "A", "text": "their perimeters"}, {"letter": "B", "text": "the lengths of their altitudes"}, {"letter": "C", "text": "their sides"}, {"letter": "D", "text": "none of these"}], "answer": "B", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 54, "prompt": "In an isosceles right triangle, the hypotenuse is ______ times as long as each of the legs.", "choices": [{"letter": "A", "text": "sq rt of 2"}, {"letter": "B", "text": "sq rt of 3"}, {"letter": "C", "text": "2"}, {"letter": "D", "text": "3"}], "answer": "A", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 55, "prompt": "Which of the following is not a secondary part of a triangle?", "choices": [{"letter": "A", "text": "Altitudes"}, {"letter": "B", "text": "Medians"}, {"letter": "C", "text": "Exterior angles"}, {"letter": "D", "text": "Sides"}], "answer": "D", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 56, "prompt": "Which of the following is not a property of a triangle?", "choices": [{"letter": "A", "text": "The sum of the three angles is always equal to two right angles."}, {"letter": "B", "text": "The sum of two sides is less than the third side."}, {"letter": "C", "text": "If the two sides are equal, the angles opposite are unequal."}, {"letter": "D", "text": "The altitudes of the triangle meet in a point."}], "answer": "B", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 57, "prompt": "Given the sides of a triangle as 3 m and 5 m. The third side is ________.", "choices": [{"letter": "A", "text": "between 3 m and 8 m"}, {"letter": "B", "text": "greater than 8 m"}, {"letter": "C", "text": "from 3 m to 7 m"}, {"letter": "D", "text": "from 2 m to 8 m"}], "answer": "C", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 58, "prompt": "A straight from the vertex of a triangle to the midpoint of the opposite side is known as ________.", "choices": [{"letter": "A", "text": "altitude"}, {"letter": "B", "text": "median"}, {"letter": "C", "text": "height"}, {"letter": "D", "text": "altitude or median"}], "answer": "B", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 59, "prompt": "Indicate the FALSE statement:", "choices": [{"letter": "A", "text": "An altitude of a triangle is a perpendicular drop from any vertex to the opposite side."}, {"letter": "B", "text": "Three or more lines which have one point in common are said to be coplanar."}, {"letter": "C", "text": "The altitudes of a triangle meet in a point."}, {"letter": "D", "text": "A locus is a figure containing all the points and only those which fulfill a given requirement."}], "answer": "B", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 60, "prompt": "The case of the solution of the triangle in the plane where the given data lead to two solutions.", "choices": [{"letter": "A", "text": "Axioms of Euclid"}, {"letter": "B", "text": "Absurd case"}, {"letter": "C", "text": "Ambiguous case"}, {"letter": "D", "text": "All of these"}], "answer": "C", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 61, "prompt": "The MOST proved theorem in Mathematics.", "choices": [{"letter": "A", "text": "Gauss lemma"}, {"letter": "B", "text": "Fermat’s theorem"}, {"letter": "C", "text": "Ptolemy’s theorem"}, {"letter": "D", "text": "Pythagorean theorem"}], "answer": "D", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 62, "prompt": "The LEAST proved theorem in Mathematics.", "choices": [{"letter": "A", "text": "Goldbach conjecture"}, {"letter": "B", "text": "Fermat’s last theorem"}, {"letter": "C", "text": "Mersennes’s proportion"}, {"letter": "D", "text": "Pappus proportions"}], "answer": "B", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 63, "prompt": "Equations used for checking the solution to a plane triangle using law of sine’s are as follows: \\(\\frac{a+b}{c}=\\frac{\\cos\\frac{1}{2}(A-B)}{\\sin\\frac{1}{2}C}\\) and \\(\\frac{a-b}{c}=\\frac{\\sin\\frac{1}{2}(A-B)}{\\cos\\frac{1}{2}C}\\). These equations are called ________.", "choices": [{"letter": "A", "text": "Diophantine equations"}, {"letter": "B", "text": "Mollweide’s equations"}, {"letter": "C", "text": "Mohr equations"}, {"letter": "D", "text": "Gauss equations"}], "answer": "B", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 64, "prompt": "Napier’s rule states that the sine of any middle part is equal to the product of the ______ of the opposite parts.", "choices": [{"letter": "A", "text": "sine"}, {"letter": "B", "text": "cosine"}, {"letter": "C", "text": "tangent"}, {"letter": "D", "text": "secant"}], "answer": "B", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
    {"id": 65, "prompt": "Napier’s rule states that the sine of any middle part is equal to the product of the ______ of the adjacent parts.", "choices": [{"letter": "A", "text": "sine"}, {"letter": "B", "text": "cosine"}, {"letter": "C", "text": "tangent"}, {"letter": "D", "text": "cotangent"}], "answer": "C", "note": "Sourced from elements_in_trigonometry.md[cite: 7]"},
